#include <windows.h>
1 RT_MANIFEST "app.manifest"
2 ICON "resources/LocalForwarder.ico"

#include "product_version.rc.h"
VS_VERSION_INFO VERSIONINFO
 FILEVERSION LF_VERSION_NUMERIC
 PRODUCTVERSION LF_VERSION_NUMERIC
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904B0"
  BEGIN
   VALUE "CompanyName", "GuruJung\0"
   VALUE "FileDescription", "LocalForwarder\0"
   VALUE "FileVersion", LF_VERSION_STRING "\0"
   VALUE "InternalName", "LocalForwarder\0"
   VALUE "OriginalFilename", "LocalForwarder.exe\0"
   VALUE "ProductName", "LocalForwarder\0"
   VALUE "ProductVersion", LF_VERSION_STRING "\0"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x0409, 1200
 END
END
